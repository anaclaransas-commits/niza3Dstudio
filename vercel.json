{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/catalogo/(.*)", "destination": "/catalogo.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
