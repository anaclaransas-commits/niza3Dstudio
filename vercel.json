{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/catalogo/:path*", "destination": "/catalogo.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
