# URL publica da API do catalogo. Use quando o frontend estiver em um host
# diferente do servidor que publica /api e /uploads.
# Exemplo: VITE_CATALOG_API_URL=https://catalogo.suaempresa.com
VITE_CATALOG_API_URL=

# Opcional: use o Supabase para publicar catálogo e imagens em um site estático
# (Netlify, Vercel etc.) sem depender da API Node.
# Use apenas a chave ANON no frontend, nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=catalog-assets
VITE_SUPABASE_PRODUCTS_TABLE=catalog_products
VITE_SUPABASE_SETTINGS_TABLE=catalog_settings
